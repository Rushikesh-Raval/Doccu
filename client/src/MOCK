


body {
  margin: 0;
  font-family: "Segoe UI", sans-serif;
  background: #f9fafb;
}

.app-wrapper {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.navbar {
  background-color: #1a202c;
  color: white;
  padding: 15px 30px;
  font-size: 20px;
  font-weight: bold;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
}

.main-content {
  flex: 1;
  max-width: 900px;
  margin: 30px auto;
  padding: 0 20px;
}

.upload-section {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: center;
  align-items: center;
  margin-bottom: 30px;
}

.file-input-label {
  background-color: #edf2f7;
  padding: 12px 18px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 500;
  border: 2px dashed #cbd5e0;
  transition: all 0.3s ease;
}

.file-input-label:hover {
  background-color: #e2e8f0;
}

.file-input-label input {
  display: none;
}

.analyze-btn {
  padding: 12px 24px;
  background-color: #38a169;
  color: white;
  font-weight: bold;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.3s ease;
}

.analyze-btn:hover {
  background-color: #2f855a;
}

.analyze-btn:disabled {
  background-color: #9ae6b4;
  cursor: not-allowed;
}

.spinner {
  display: inline-block;
  width: 20px;
  height: 20px;
  border: 3px solid white;
  border-top: 3px solid #2f855a;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.card-container {
  margin-top: 20px;
}

.card {
  background: white;
  margin-bottom: 20px;
  border-radius: 10px;
  border-left: 6px solid #ccc;
  overflow: hidden;
}

.card-header {
  padding: 14px 18px;
  font-weight: bold;
  font-size: 18px;
  cursor: pointer;
}

.green {
  border-left-color: #38a169;
  background-color: #f0fff4;
}

.red {
  border-left-color: #e53e3e;
  background-color: #fff5f5;
}

.yellow {
  border-left-color: #ecc94b;
  background-color: #fffff0;
}

.blue {
  border-left-color: #4299e1;
  background-color: #ebf8ff;
}

.card-body {
  padding: 16px 20px;
  line-height: 1.6;
}

.ask-box {
  margin-top: 40px;
  background: white;
  padding: 20px;
  border-radius: 10px;
  border: 1px solid #cbd5e0;
}

.ask-input {
  width: 100%;
  padding: 10px 12px;
  margin-top: 10px;
  margin-bottom: 12px;
  border: 1px solid #cbd5e0;
  border-radius: 6px;
}

.ask-btn {
  background-color: #2b6cb0;
  color: white;
  padding: 10px 18px;
  border: none;
  border-radius: 6px;
  cursor: pointer;
}

.ask-btn:hover {
  background-color: #2c5282;
}

.answer-box {
  margin-top: 15px;
  padding: 14px;
  background-color: #f7fafc;
  border-left: 4px solid #2b6cb0;
  border-radius: 6px;
}

.footer {
  background-color: #1a202c;
  color: #a0aec0;
  padding: 16px 0;
  text-align: center;
  font-size: 14px;
}

